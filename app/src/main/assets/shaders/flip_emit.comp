#version 310 es
precision highp float;
layout(local_size_x = 64) in;

// Emits particles into a fixed pool as a ring buffer. The write head is managed
// on the host, so no atomics are needed and emission stays deterministic --
// which the replay log depends on (PRD FR-20).

layout(std430, binding = 0) buffer Particles {
    vec4 data[];        // [2i] = pos.xy, vel.xy   [2i+1] = ink, age, state, seed
};

uniform int   uHead;        // first slot to write
uniform int   uCount;       // how many to emit
uniform int   uCapacity;
uniform vec2  uPoint;
uniform vec2  uVel;
uniform float uRadius;
uniform float uAspect;    // width / height
uniform float uInk;
uniform float uJitterSeed;

float hash(float n) { return fract(sin(n) * 43758.5453); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= uCount) return;

    int slot = (uHead + int(i)) % uCapacity;

    float s = uJitterSeed + float(i) * 7.13;
    float a = hash(s) * 6.2831853;
    float rr = sqrt(hash(s + 1.7)) * uRadius;

    // Scatter in WORLD units, not UV. Every other brush measures its radius
    // with x scaled by the aspect, so scattering in UV made a dab an ellipse
    // as wide as the canvas is oblong while calling itself the same size.
    vec2 pos = uPoint + vec2(cos(a) / uAspect, sin(a)) * rr;
    vec2 vel = uVel * (0.7 + 0.6 * hash(s + 3.1));

    data[slot * 2]     = vec4(pos, vel);
    data[slot * 2 + 1] = vec4(uInk, 0.0, 1.0, hash(s + 5.9));   // state 1 = live
}
