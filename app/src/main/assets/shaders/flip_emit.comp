#version 310 es
precision highp float;
layout(local_size_x = 64) in;

// Emits particles into a fixed pool as a ring buffer. The write head is managed
// on the host, so no atomics are needed and emission stays deterministic --
// which the replay log depends on (PRD FR-20).

layout(std430, binding = 0) buffer Particles {
    vec4 data[];        // [2i] = pos.xy, vel.xy   [2i+1] = ink, age, state, seed
};

uniform int   uHead;        // first slot to write
uniform int   uCount;       // how many to emit
uniform int   uCapacity;
uniform vec2  uPoint;
uniform vec2  uVel;
// The far end of the segment this emission covers, and the velocity there. A
// pour from a moving finger is a STREAM: each particle lands at its own spot
// along the path the finger travelled this frame, moving as the finger moved
// at that spot -- both position and motion vector are interpolated, so a
// stroke is a ribbon rather than a chain of dots. Callers emitting a point
// dab pass the same values for both ends.
uniform vec2  uPointB;
uniform vec2  uVelB;
uniform float uRadius;
uniform float uAspect;    // width / height
uniform vec2  uAxis;      // unit vector along the contact's long axis, world space
uniform float uMinor;     // minor over major; 1.0 is a circle
uniform float uInk;
uniform float uJitterSeed;

float hash(float n) { return fract(sin(n) * 43758.5453); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (int(i) >= uCount) return;

    int slot = (uHead + int(i)) % uCapacity;

    float s = uJitterSeed + float(i) * 7.13;
    float a = hash(s) * 6.2831853;
    float rr = sqrt(hash(s + 1.7)) * uRadius;

    // Scatter in WORLD units, not UV. Every other brush measures its radius
    // with x scaled by the aspect, so scattering in UV made a dab an ellipse
    // as wide as the canvas is oblong while calling itself the same size.
    //
    // The disc is squashed across the contact's short axis and turned to lie
    // along it, so a pool of particles takes the shape of the fingertip.
    vec2 ax = dot(uAxis, uAxis) > 0.5 ? uAxis : vec2(1.0, 0.0);
    float mn = uMinor > 0.05 ? uMinor : 1.0;
    vec2 off = vec2(cos(a), sin(a) * mn) * rr;
    vec2 world = vec2(off.x * ax.x - off.y * ax.y,
                      off.x * ax.y + off.y * ax.x);
    float t = hash(s + 9.3);
    vec2 centre = mix(uPoint, uPointB, t);
    vec2 velAt = mix(uVel, uVelB, t);

    vec2 pos = centre + vec2(world.x / uAspect, world.y);
    vec2 vel = velAt * (0.7 + 0.6 * hash(s + 3.1));

    // Birth age is jittered by up to ~1.5 frames. Emission is per frame, so
    // without this every particle of a frame's cohort reaches the settle time
    // in the SAME tick and freezes as one cluster -- a stroke dried as a
    // chain of knots, one per frame. Spread the clocks and drying is
    // continuous along the stroke.
    float age0 = hash(s + 11.7) * 0.05;
    data[slot * 2]     = vec4(pos, vel);
    data[slot * 2 + 1] = vec4(uInk, age0, 1.0, hash(s + 5.9));   // state 1 = live
}
