#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

// Red-black Gauss-Seidel with a free surface. Cells holding no particles are
// air and are pinned to zero pressure, which is what lets the liquid have a
// surface at all instead of behaving as though sealed in a box.

layout(r32f, binding = 0) uniform highp image2D uPressure;
layout(r32f, binding = 2) readonly uniform highp image2D uDiv;
layout(r32f, binding = 3) readonly uniform highp image2D uMass;

uniform int   uParity;
uniform float uMinMass;
// Successive over-relaxation: each sweep overshoots toward the Gauss-Seidel
// value, reaching the same residual in a fraction of the sweeps -- the
// difference between a working pressure solve and none at the low sweep
// counts the slider allows. The reference uses 1.9; measured here, with air
// cells pinned at zero, 1.9 diverges early and 1.5 is the robust choice.
uniform float uOmega;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uPressure);
    if (g.y >= sz.y) return;
    int x = 2 * g.x + ((g.y + uParity) & 1);
    if (x >= sz.x) return;
    ivec2 c = ivec2(x, g.y);

    if (imageLoad(uMass, c).x < uMinMass) {
        imageStore(uPressure, c, vec4(0.0));   // air
        return;
    }

    ivec2 mx = sz - 1;
    float l = imageLoad(uPressure, clamp(c + ivec2(-1, 0), ivec2(0), mx)).x;
    float r = imageLoad(uPressure, clamp(c + ivec2( 1, 0), ivec2(0), mx)).x;
    float b = imageLoad(uPressure, clamp(c + ivec2( 0,-1), ivec2(0), mx)).x;
    float t = imageLoad(uPressure, clamp(c + ivec2( 0, 1), ivec2(0), mx)).x;
    float d = imageLoad(uDiv, c).x;

    float pOld = imageLoad(uPressure, c).x;
    float pGS = (l + r + b + t - d) * 0.25;
    imageStore(uPressure, c, vec4(pOld + uOmega * (pGS - pOld), 0.0, 0.0, 0.0));
}
