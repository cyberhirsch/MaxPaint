#version 310 es
precision highp float;
layout(local_size_x = 64) in;

// Particle to grid, on a STAGGERED (MAC) layout.
//
// The x component of cell c lives on its LEFT face, the y component on its
// BOTTOM face. That is what the forward-divergence / backward-gradient pair in
// divergence_flip.comp and gradsub_flip.comp assumes. Scattering both
// components to the cell centre instead leaves a half-cell mismatch, which
// shows up as the whole field drifting steadily in -x and -y even with no
// force applied at all.
//
// ES 3.1 has no float atomics, so momentum and weight accumulate as fixed-point
// integers; each component keeps its own weight because their sample points
// differ.

layout(std430, binding = 0) buffer Particles { vec4 data[]; };
layout(std430, binding = 1) buffer GridAccum { int acc[]; };   // vx, wx, vy, wy

uniform int   uCapacity;
uniform ivec2 uGrid;

const float SCALE = 4096.0;

void addX(ivec2 c, float v, float w) {
    if (c.x < 0 || c.y < 0 || c.x >= uGrid.x || c.y >= uGrid.y) return;
    int i = (c.y * uGrid.x + c.x) * 4;
    atomicAdd(acc[i],     int(v * w * SCALE));
    atomicAdd(acc[i + 1], int(w * SCALE));
}

void addY(ivec2 c, float v, float w) {
    if (c.x < 0 || c.y < 0 || c.x >= uGrid.x || c.y >= uGrid.y) return;
    int i = (c.y * uGrid.x + c.x) * 4;
    atomicAdd(acc[i + 2], int(v * w * SCALE));
    atomicAdd(acc[i + 3], int(w * SCALE));
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uCapacity) return;

    vec4 meta = data[i * 2 + 1];
    if (meta.z < 0.5 || meta.z > 1.5) return;

    vec4 pv = data[i * 2];
    vec2 pos = pv.xy;
    vec2 vel = pv.zw;
    vec2 g = pos * vec2(uGrid);

    // x lives on left faces: sample space is offset half a cell in y
    vec2 qx = vec2(g.x, g.y - 0.5);
    ivec2 bx = ivec2(floor(qx));
    vec2 fx = qx - vec2(bx);
    addX(bx,                 vel.x, (1.0 - fx.x) * (1.0 - fx.y));
    addX(bx + ivec2(1, 0),   vel.x, fx.x * (1.0 - fx.y));
    addX(bx + ivec2(0, 1),   vel.x, (1.0 - fx.x) * fx.y);
    addX(bx + ivec2(1, 1),   vel.x, fx.x * fx.y);

    // y lives on bottom faces: offset half a cell in x
    vec2 qy = vec2(g.x - 0.5, g.y);
    ivec2 by = ivec2(floor(qy));
    vec2 fy = qy - vec2(by);
    addY(by,                 vel.y, (1.0 - fy.x) * (1.0 - fy.y));
    addY(by + ivec2(1, 0),   vel.y, fy.x * (1.0 - fy.y));
    addY(by + ivec2(0, 1),   vel.y, (1.0 - fy.x) * fy.y);
    addY(by + ivec2(1, 1),   vel.y, fy.x * fy.y);
}
