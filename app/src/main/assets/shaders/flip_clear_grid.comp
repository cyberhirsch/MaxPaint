#version 310 es
precision highp float;
layout(local_size_x = 64) in;

// Resets the grid accumulator for this frame's particle-to-grid transfer.
//
// Six ints per cell: x-momentum, x-weight, y-momentum, y-weight, density,
// cell type. The canvas has no interior solids -- the walls live implicitly
// outside the grid, so every cell starts as AIR (1) and the P2G pass promotes
// cells holding a particle to FLUID (2). SOLID (0) only ever appears as the
// out-of-bounds answer.

layout(std430, binding = 1) buffer GridAccum { int acc[]; };
uniform int uCells;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uCells) return;
    acc[i * 6]     = 0;
    acc[i * 6 + 1] = 0;
    acc[i * 6 + 2] = 0;
    acc[i * 6 + 3] = 0;
    acc[i * 6 + 4] = 0;
    acc[i * 6 + 5] = 1;   // AIR
}
