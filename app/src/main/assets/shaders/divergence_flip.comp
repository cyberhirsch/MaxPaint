#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly  uniform highp image2D uVel;
layout(r32f,    binding = 1) writeonly uniform highp image2D uDiv;
layout(r32f,    binding = 2) readonly  uniform highp image2D uMass;

// Particles resting in one cell produce no divergence, so an incompressible
// solve alone has nothing to object to and they stack without limit -- 4x the
// paint in the same 32 cells. A volume needs a term that notices a cell is
// over-full: an over-full cell is given a fake source, and the projection then
// pushes paint out of it until the density comes back down.
//
// uRest is where that starts, in the same units as the mass field: each
// particle contributes a bilinear weight of 1 per axis, which the cell-centred
// reconstruction averages to about half a particle, so rest is half the
// emission density.
uniform float uRest;
uniform float uCompression;   // 0 disables it entirely
uniform float uCap;           // how over-full a cell may read, so one clump cannot dominate

// FORWARD differences, paired with the BACKWARD gradient in gradsub.comp.
//
// Used by the PARTICLE solver only.
//
// The gas brush uses centred differences, which measure better there and are
// the conventional collocated scheme. They fail for a free surface: centred
// differences span two cells, so a liquid region only a few cells thick is
// effectively decoupled from its own pressure and the solve converges
// immediately to something that is not divergence-free. Forward divergence with
// a backward gradient composes to exactly the compact five-point Laplacian the
// pressure solve inverts, which a thin region needs.
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uDiv);
    if (c.x >= sz.x || c.y >= sz.y) return;
    ivec2 mx = sz - 1;

    vec2 here = imageLoad(uVel, c).xy;

    // Solid walls, applied to the correct face. On a staggered grid the x
    // component of cell c sits on its LEFT face, so the wall condition belongs
    // at c.x == 0 -- zeroing it at the far edge instead both misses the left
    // wall and clobbers an interior face, which makes the boundary asymmetric
    // and drifts the whole field along that axis.
    float right = c.x < mx.x ? imageLoad(uVel, c + ivec2(1, 0)).x : 0.0;
    float up    = c.y < mx.y ? imageLoad(uVel, c + ivec2(0, 1)).y : 0.0;
    float hx    = c.x > 0    ? here.x : 0.0;
    float hy    = c.y > 0    ? here.y : 0.0;

    float div = (right - hx) + (up - hy);

    if (uCompression > 0.0) {
        float over = clamp(imageLoad(uMass, c).x - uRest, 0.0, uCap);
        div -= over * uCompression;
    }

    imageStore(uDiv, c, vec4(div, 0.0, 0.0, 0.0));
}
