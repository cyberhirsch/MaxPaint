#version 310 es
precision highp float;
precision highp sampler2D;
layout(local_size_x = 64) in;

// Grid to particle: transferVelocities(fromGrid) from the reference solver.
//
// Per component, gather the four surrounding face values with bilinear hat
// weights -- but only from faces that touch a non-air cell, so a particle
// near the surface never averages in the zero velocity of empty space. The
// blend is real FLIP: the grid's CHANGE is added to the particle's own
// velocity, and mixed with the pure grid velocity by uFlipRatio.
//
//   v_pic  = gather(vel)
//   v_flip = v_particle + gather(vel - velBeforeSolve)
//   v      = mix(v_pic, v_flip, ratio)
//
// The ratio is clamped at 1.0. Past it the blend extrapolates and multiplies
// the particle's disagreement with the grid every frame -- measured with no
// input at all, kinetic energy grew 10x in forty frames at 1.15. On top of
// the port ride MaxPaint's own layers: drag, cohesion (there is no gravity
// to gather paint into drops), a CFL clamp, and the settle/dry lifecycle.
// Positions do not move here; that is next frame's integrate pass.

layout(std430, binding = 0) buffer Particles { vec4 data[]; };
// per cell: xMom, xW, yMom, yW, density, cellType (0 solid, 1 air, 2 fluid)
layout(std430, binding = 1) buffer GridAccum { int acc[]; };

// u and v are separate r32f textures (the solve needs read-write images, and
// r32f is the only float format ES 3.1 guarantees that for); density is a
// filterable rgba16f so cohesion gets a smooth gradient
layout(binding = 0) uniform highp sampler2D uUNew;   // after the solve
layout(binding = 1) uniform highp sampler2D uVNew;
layout(binding = 2) uniform highp sampler2D uUOld;   // before the solve
layout(binding = 3) uniform highp sampler2D uVOld;
layout(binding = 4) uniform highp sampler2D uDensity;

uniform float uDt;
uniform int   uCapacity;
uniform ivec2 uGrid;
uniform float uFlipRatio;
uniform float uDrag;
uniform float uSettleSpeed;
uniform float uSettleMinAge;
uniform float uCohesionSpeed;  // world units/s the surface may creep
uniform float uRestMass;       // emission density, particles per cell
uniform float uMaxSpeed;       // CFL guard
uniform vec2  uTexel;

int cellType(ivec2 c) {
    if (c.x < 0 || c.y < 0 || c.x >= uGrid.x || c.y >= uGrid.y) return 0;
    return acc[(c.y * uGrid.x + c.x) * 6 + 5];
}

// A face is valid when either cell beside it holds something other than air.
float validFace(ivec2 face, ivec2 axis) {
    return (cellType(face) != 1 || cellType(face - axis) != 1) ? 1.0 : 0.0;
}

float fetch(sampler2D t, ivec2 c) {
    return texelFetch(t, clamp(c, ivec2(0), uGrid - 1), 0).x;
}

// Gathers one staggered component; returns (pic, corr, weight).
vec3 gather(vec2 g, int comp) {
    ivec2 axis = comp == 0 ? ivec2(1, 0) : ivec2(0, 1);
    vec2 q = comp == 0 ? vec2(g.x, g.y - 0.5) : vec2(g.x - 0.5, g.y);
    ivec2 b = ivec2(floor(q));
    vec2 f = q - vec2(b);

    float pic = 0.0, corr = 0.0, wsum = 0.0;
    for (int dy = 0; dy <= 1; dy++) {
        for (int dx = 0; dx <= 1; dx++) {
            ivec2 c = b + ivec2(dx, dy);
            float w = (dx == 0 ? 1.0 - f.x : f.x) * (dy == 0 ? 1.0 - f.y : f.y);
            float valid = validFace(c, axis);
            float vNew = comp == 0 ? fetch(uUNew, c) : fetch(uVNew, c);
            float vOld = comp == 0 ? fetch(uUOld, c) : fetch(uVOld, c);
            pic  += valid * w * vNew;
            corr += valid * w * (vNew - vOld);
            wsum += valid * w;
        }
    }
    return vec3(pic, corr, wsum);
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uCapacity) return;

    vec4 meta = data[i * 2 + 1];
    float state = meta.z;

    if (state > 1.5) { data[i * 2 + 1] = vec4(0.0); return; }   // retire
    if (state < 0.5) return;

    vec4 pv = data[i * 2];
    vec2 pos = pv.xy;
    vec2 vel = pv.zw;
    vec2 g = pos * vec2(uGrid);

    float ratio = clamp(uFlipRatio, 0.0, 1.0);
    vec2 gridVel = vec2(0.0);   // the local fluid's own motion (pure PIC)
    for (int comp = 0; comp < 2; comp++) {
        vec3 r = gather(g, comp);
        if (r.z > 0.0) {
            float pic = r.x / r.z;
            float flipV = (comp == 0 ? vel.x : vel.y) + r.y / r.z;
            float blended = mix(pic, flipV, ratio);
            if (comp == 0) { vel.x = blended; gridVel.x = pic; }
            else           { vel.y = blended; gridVel.y = pic; }
        }
    }

    // Cohesion: a TARGET VELOCITY the surface relaxes toward, never a force
    // -- a force with a per-frame accumulation was an energy source (see git
    // history). With no gravity this is what gathers paint into droplets.
    if (uCohesionSpeed > 0.0) {
        vec2 t = uTexel;
        vec2 uv = pos;
        float mHere = texture(uDensity, uv).x;
        float mL = texture(uDensity, uv - vec2(t.x, 0.0)).x;
        float mR = texture(uDensity, uv + vec2(t.x, 0.0)).x;
        float mB = texture(uDensity, uv - vec2(0.0, t.y)).x;
        float mT = texture(uDensity, uv + vec2(0.0, t.y)).x;
        vec2 grad = 0.5 * vec2(mR - mL, mT - mB);
        float gmag = length(grad);

        // The gate closes AT rest density, because that is where the solve's
        // drift compensation starts pushing back: a gate that let cohesion
        // pull toward 1.8x rest (as the pre-rewrite one did) asks for exactly
        // the density the solve forbids, and at high cohesion the two fight
        // forever -- measured as a permanent 22-unit kinetic-energy plateau
        // at slider max, where this gate settles to rest.
        float surface = 1.0 - smoothstep(0.7 * uRestMass, uRestMass, mHere);
        float body = mL + mR + mB + mT;

        if (surface > 0.0 && body > uRestMass && gmag > 0.02 * uRestMass) {
            vec2 dirHat = grad / gmag;
            float sat = clamp(gmag / (0.4 * uRestMass), 0.0, 1.0);
            float target = uCohesionSpeed * surface * sat;
            float along = dot(vel, dirHat);
            float rate = min(1.0, 30.0 * uDt);
            vel += dirHat * (target - along) * rate;
        }
    }

    vel *= 1.0 / (1.0 + uDrag * uDt);

    if (uMaxSpeed > 0.0) {
        float sp = length(vel);
        if (sp > uMaxSpeed) vel *= uMaxSpeed / sp;
    }

    float age = meta.y + uDt;
    // A particle dries only when IT is slow AND the fluid around it is too.
    // Emission gives each particle a random share (0.7-1.3x) of the stroke's
    // velocity, so the settle threshold used to slice through a fresh pour's
    // spread: the slow tail froze on the spot at min age while its siblings
    // flew on -- paint sticking mid-stroke beside paint in flight. The local
    // grid velocity is the pure PIC gather, already in hand; wet paint in a
    // moving body now stays wet until the body itself comes to rest.
    if (length(vel) < uSettleSpeed && length(gridVel) < uSettleSpeed &&
        age > uSettleMinAge) state = 2.0;

    data[i * 2]     = vec4(pos, vel);
    data[i * 2 + 1] = vec4(meta.x, age, state, meta.w);
}
