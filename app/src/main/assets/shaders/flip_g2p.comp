#version 310 es
precision highp float;
precision highp sampler2D;
layout(local_size_x = 64) in;

// Grid to particle, with the blend FLIP actually specifies.
//
// The previous version blended toward the ABSOLUTE grid velocity, which throws
// away the particle's history every step and behaves like PIC with inertia.
// Real FLIP adds the grid's CHANGE to the particle's own velocity, so detail
// the grid cannot represent survives:
//
//   v_pic  = v_grid_new
//   v_flip = v_particle + (v_grid_new - v_grid_old)
//   v      = mix(v_pic, v_flip, ratio)

layout(std430, binding = 0) buffer Particles { vec4 data[]; };

layout(binding = 0) uniform highp sampler2D uVelNew;   // after projection
layout(binding = 1) uniform highp sampler2D uVelOld;   // before projection

uniform float uDt;
uniform int   uCapacity;
uniform float uFlipRatio;
uniform float uDrag;
uniform float uAspect;
uniform float uSettleSpeed;
uniform float uSettleMinAge;
uniform float uCohesionSpeed;  // world units/s the surface may creep
uniform float uRestMass;       // emission density in mass units   // surface tension: pulls paint into droplets
uniform float uMaxSpeed;   // CFL guard, same as the grid uses
uniform vec2  uTexel;      // 1 / grid, for the staggered sample offsets

// The grid is staggered: x lives on left faces, y on bottom faces. Each
// component must therefore be sampled at its own point, half a cell apart --
// sampling both at the cell centre leaves the field biased.
vec2 sampleStaggered(sampler2D tex, vec2 uv) {
    float vx = texture(tex, uv + vec2(0.5 * uTexel.x, 0.0)).x;
    float vy = texture(tex, uv + vec2(0.0, 0.5 * uTexel.y)).y;
    return vec2(vx, vy);
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uCapacity) return;

    vec4 meta = data[i * 2 + 1];
    float state = meta.z;

    if (state > 1.5) { data[i * 2 + 1] = vec4(0.0); return; }   // retire
    if (state < 0.5) return;

    vec4 pv = data[i * 2];
    vec2 pos = pv.xy;
    vec2 vel = pv.zw;

    vec2 gNew = sampleStaggered(uVelNew, pos);
    vec2 gOld = sampleStaggered(uVelOld, pos);

    vec2 pic  = gNew;
    vec2 flip = vel + (gNew - gOld);
    // Capped at 1.0, which is pure FLIP: the particle keeps ALL of its own
    // motion. There is nothing beyond that to inherit.
    //
    // It was briefly allowed past 1.0, where the blend extrapolates --
    // vel = gNew + r*(v - gOld) -- so the particle's disagreement with the grid
    // is multiplied by r every step rather than merely kept. That is a positive
    // feedback loop and it does what feedback loops do: measured with no input
    // at all, kinetic energy grew 10x in forty frames at r = 1.15, while every
    // value at or below 1.0 decayed monotonically. What looked like liveliness
    // was energy arriving from nowhere.
    vel = mix(pic, flip, clamp(uFlipRatio, 0.0, 1.0));

    // Cohesion. With no gravity there is nothing to gather the paint, so
    // without this it simply disperses and never reads as liquid.
    //
    // It is a TARGET VELOCITY the particle relaxes toward, never a force. The
    // first version accumulated uCohesion * dir * uDt every frame, and that is
    // an energy source: a blob at rest always has a surface, a surface always
    // has a density gradient, and dividing the gradient by the near-zero mass
    // at the free edge saturated the clamp -- so every rim particle received
    // the maximum acceleration forever, regardless of how weak the gradient
    // was. Measured: a resting blob at the shipped Mercury preset held a
    // permanent kinetic-energy plateau with particles pinned at the CFL cap,
    // and could never dry, because settling needs them to slow down. Drag
    // cannot fix it (the implied terminal speed is orders of magnitude past
    // the cap) and pure PIC still pumps, so the bound has to be structural.
    //
    // Relaxing toward a bounded target is that bound: the sustainable speed
    // along the gradient can never exceed uCohesionSpeed, whatever the drag or
    // the blend, and overshoot is actively removed rather than kept.
    if (uCohesionSpeed > 0.0) {
        vec2 t = uTexel;
        float mHere = texture(uVelNew, pos).z;
        float mL = texture(uVelNew, pos - vec2(t.x, 0.0)).z;
        float mR = texture(uVelNew, pos + vec2(t.x, 0.0)).z;
        float mB = texture(uVelNew, pos - vec2(0.0, t.y)).z;
        float mT = texture(uVelNew, pos + vec2(0.0, t.y)).z;
        vec2 grad = 0.5 * vec2(mR - mL, mT - mB);
        float gmag = length(grad);

        // Surface tension belongs to the surface: fade to nothing inside the
        // bulk, so a filled interior is left to the pressure solve. The fade
        // starts late -- a bead keeps its full pull until it is nearly at rest
        // density, or it stalls half-formed.
        float surface = 1.0 - smoothstep(0.8 * uRestMass, 1.1 * uRestMass, mHere);

        // And it needs an actual body of paint to pull toward. The neighbour
        // mass gate kills the self-force -- a lone particle's neighbours hold
        // only its own spill-over, so it no longer chases its own field -- and
        // with it the vacuum-fringe noise that used to saturate the old clamp.
        float body = mL + mR + mB + mT;

        if (surface > 0.0 && body > uRestMass && gmag > 0.02 * uRestMass) {
            vec2 dirHat = grad / gmag;
            // Saturating in the gradient: a real density edge earns the full
            // target, the speckle of a sparse haze earns almost none -- so
            // thin paint drifts toward genuine beads instead of jittering
            // toward whichever neighbour cell is momentarily denser.
            float sat = clamp(gmag / (0.4 * uRestMass), 0.0, 1.0);
            float target = uCohesionSpeed * surface * sat;
            float along = dot(vel, dirHat);
            // ~33 ms relaxation. The projection cancels convergent motion
            // every frame -- correctly, that is its job -- so the creep only
            // exists in the interval between this kick and the next solve, and
            // a slow rate loses most of the target to that cancellation. The
            // energy bound does not care about the rate: however fast the
            // relaxation, the speed it can sustain along the gradient is
            // capped by the target.
            float rate = min(1.0, 30.0 * uDt);
            vel += dirHat * (target - along) * rate;
        }
    }

    vel *= 1.0 / (1.0 + uDrag * uDt);

    // particles get the same CFL guard as the grid; without it cohesion could
    // accelerate one past anything the simulation can represent
    if (uMaxSpeed > 0.0) {
        float sp = length(vel);
        if (sp > uMaxSpeed) vel *= uMaxSpeed / sp;
    }

    pos += vec2(vel.x / uAspect, vel.y) * uDt;

    if (pos.x < 0.0) { pos.x = 0.0; vel.x = abs(vel.x) * 0.2; }
    if (pos.x > 1.0) { pos.x = 1.0; vel.x = -abs(vel.x) * 0.2; }
    if (pos.y < 0.0) { pos.y = 0.0; vel.y = abs(vel.y) * 0.2; }
    if (pos.y > 1.0) { pos.y = 1.0; vel.y = -abs(vel.y) * 0.2; }

    float age = meta.y + uDt;
    if (length(vel) < uSettleSpeed && age > uSettleMinAge) state = 2.0;

    data[i * 2]     = vec4(pos, vel);
    data[i * 2 + 1] = vec4(meta.x, age, state, meta.w);
}
