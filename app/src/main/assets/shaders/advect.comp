#version 310 es
precision highp float;
precision highp sampler2D;
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform highp sampler2D uSrc;   // quantity being advected
layout(binding = 1) uniform highp sampler2D uVel;   // velocity, WORLD units per second
layout(rgba16f, binding = 0) writeonly uniform highp image2D uDst;

uniform vec2  uDstTexel;      // 1.0 / dstSize
uniform float uDt;
uniform float uDissipation;
uniform float uAspect;      // canvas width / height   // per second

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uDst);
    if (c.x >= sz.x || c.y >= sz.y) return;

    vec2 uv = (vec2(c) + 0.5) * uDstTexel;
    vec2 vel = texture(uVel, uv).xy;

    // Velocity is in world units, where the canvas spans x in [0, aspect] and
    // y in [0, 1]. Converting to a UV step keeps motion isotropic on a
    // non-square grid -- otherwise a diagonal stroke curves.
    vec2 src = uv - uDt * vec2(vel.x / uAspect, vel.y);
    vec4 q = texture(uSrc, src);

    float decay = 1.0 / (1.0 + uDissipation * uDt);
    imageStore(uDst, c, q * decay);
}
