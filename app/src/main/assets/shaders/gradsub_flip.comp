#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) readonly  uniform highp image2D uVelSrc;
layout(rgba16f, binding = 1) writeonly uniform highp image2D uVelDst;
layout(r32f,    binding = 2) readonly  uniform highp image2D uPressure;

uniform float uDrag;      // velocity dissipation per second
uniform float uDt;
uniform float uMaxSpeed;  // CFL guard; 0 disables

// Backward gradient, paired with the forward divergence in
// divergence_flip.comp. Particle solver only; see there for why.
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uVelDst);
    if (c.x >= sz.x || c.y >= sz.y) return;
    ivec2 mx = sz - 1;

    float p  = imageLoad(uPressure, c).x;
    float pl = c.x > 0 ? imageLoad(uPressure, c + ivec2(-1, 0)).x : p;
    float pb = c.y > 0 ? imageLoad(uPressure, c + ivec2( 0,-1)).x : p;

    vec4 v = imageLoad(uVelSrc, c);
    v.xy -= vec2(p - pl, p - pb);
    v.xy *= 1.0 / (1.0 + uDrag * uDt);

    // A brush held down can otherwise drive the field past what a single
    // semi-Lagrangian backtrace can represent, at which point dye is created
    // rather than moved. Cap the speed instead of letting the canvas blow up.
    if (uMaxSpeed > 0.0) {
        float sp = length(v.xy);
        if (sp > uMaxSpeed) v.xy *= uMaxSpeed / sp;
    }

    // free-slip walls: kill the normal component at the border
    if (c.x == 0 || c.x == mx.x) v.x = 0.0;
    if (c.y == 0 || c.y == mx.y) v.y = 0.0;

    imageStore(uVelDst, c, v);
}
