#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

// A debugging brush: draws the contact patch the digitiser reported, exactly as
// the paint brushes are being told to use it. Nothing is simulated -- it marks
// the permanent layer directly, so a stroke leaves a readable record of every
// sample.
//
// It leaves a fingerprint: the reported patch, filled, at the size and shape
// and angle the paint brushes are being handed. A hard edge on purpose -- a
// soft one would make the size a matter of opinion.
//
// Three answers, three marks, no text to read:
//   a filled print -- the driver reported an actual contact patch
//   an outline     -- only a normalised area, so this size is derived, not measured
//   a bare dot     -- nothing at all, and Fingerprint has nothing to work with

layout(rgba16f, binding = 0) readonly  uniform highp image2D uSrc;
layout(rgba16f, binding = 1) writeonly uniform highp image2D uDst;

uniform vec2  uPoint;
uniform float uRadius;   // major radius in world units; <= 0 means nothing reported
uniform vec2  uAxis;     // unit vector along the long axis
uniform float uMinor;    // minor over major
uniform float uAspect;
uniform float uDot;      // radius of the centre dot, world units
uniform int   uOutline;  // 1 = derived from a normalised area, so draw a rim

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uDst);
    if (c.x >= sz.x || c.y >= sz.y) return;

    vec4 prev = imageLoad(uSrc, c);
    vec2 uv = (vec2(c) + 0.5) / vec2(sz);
    vec2 d = uv - uPoint;
    d.x *= uAspect;

    float ink;
    if (uRadius > 0.0) {
        vec2 ax = dot(uAxis, uAxis) > 0.5 ? uAxis : vec2(1.0, 0.0);
        float mn = uMinor > 0.05 ? uMinor : 1.0;
        vec2 e = vec2(dot(d, ax), dot(d, vec2(-ax.y, ax.x)) / mn);

        // 1.0 exactly on the boundary of the reported ellipse. Only the last
        // fraction of a cell is feathered, so the print has a definite edge
        // and its size can be read off the canvas.
        float r = length(e) / uRadius;
        float aa = 0.03;
        if (uOutline == 1) {
            float w = max(0.12, 0.004 / uRadius);   // stays visible when small
            ink = 1.0 - smoothstep(w * 0.5, w, abs(r - 1.0));
        } else {
            ink = 1.0 - smoothstep(1.0 - aa, 1.0, r);
        }
    } else {
        // nothing reported: just the point that was touched
        ink = 1.0 - smoothstep(uDot * 0.6, uDot, length(d));
    }

    // premultiplied black over whatever is there
    imageStore(uDst, c, vec4(prev.rgb * (1.0 - ink), prev.a * (1.0 - ink) + ink));
}
