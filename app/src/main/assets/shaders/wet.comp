#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

// Loading the brush: adds water and pigment. Painting into a still-damp area
// bleeds; painting onto dry paper does not. That difference is the whole
// expressive mechanic of the medium, and it comes for free from the wet mask
// persisting between strokes.

layout(rgba16f, binding = 0) readonly  uniform highp image2D uSrc;
layout(rgba16f, binding = 1) writeonly uniform highp image2D uDst;

uniform vec2  uPoint;
uniform float uRadius;
uniform float uAspect;
uniform vec2  uAxis;     // unit vector along the contact's long axis, world space
uniform float uMinor;    // minor over major; 1.0 is a circle
uniform float uWater;
uniform float uPigment;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uDst);
    if (c.x >= sz.x || c.y >= sz.y) return;

    vec4 w = imageLoad(uSrc, c);

    vec2 uv = (vec2(c) + 0.5) / vec2(sz);
    vec2 d = uv - uPoint;
    d.x *= uAspect;

    // Into the contact patch's own frame, stretching across its short axis so
    // one radius describes an ellipse. uAxis (1,0) with uMinor 1 is a circle
    // and reproduces the round dab exactly.
    // A zero axis or minor means nobody set them -- an unset uniform is 0, and
    // a degenerate frame would inflate the dab over the whole canvas. The
    // failure-safe reading of "no contact reported" is a circle.
    vec2 ax = dot(uAxis, uAxis) > 0.5 ? uAxis : vec2(1.0, 0.0);
    float mn = uMinor > 0.05 ? uMinor : 1.0;

    vec2 e = vec2(dot(d, ax), dot(d, vec2(-ax.y, ax.x)) / mn);

    float falloff = exp(-dot(e, e) / max(uRadius * uRadius, 1e-8));

    if (falloff > 0.002) {
        w.x += uWater * falloff;
        w.y += uPigment * falloff;
    }

    imageStore(uDst, c, w);
}
