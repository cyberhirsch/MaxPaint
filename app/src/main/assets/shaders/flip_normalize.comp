#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

// Each component is divided by its own accumulated weight, because on a
// staggered grid the two components are sampled at different points.

layout(std430, binding = 1) buffer GridAccum { int acc[]; };

layout(rgba16f, binding = 0) writeonly uniform highp image2D uVel;
layout(r32f,    binding = 1) writeonly uniform highp image2D uMass;

uniform ivec2 uGrid;

int idx(ivec2 c) { return (clamp(c, ivec2(0), uGrid - 1).y * uGrid.x
                         + clamp(c, ivec2(0), uGrid - 1).x) * 4; }

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= uGrid.x || c.y >= uGrid.y) return;

    int i = (c.y * uGrid.x + c.x) * 4;
    float vx = float(acc[i]);
    float wx = float(acc[i + 1]);
    float vy = float(acc[i + 2]);
    float wy = float(acc[i + 3]);

    vec2 v = vec2(wx > 0.5 ? vx / wx : 0.0,
                  wy > 0.5 ? vy / wy : 0.0);

    // Cell-CENTRED mass, reconstructed by averaging each face pair.
    //
    // wx is sampled half a cell below the centre and wy half a cell to the
    // left, so simply averaging them gives a field skewed along the diagonal.
    // Its gradient then carries a constant diagonal bias, and anything that
    // follows that gradient -- cohesion -- walks the whole liquid into a
    // corner instead of gathering it.
    float wxr = float(acc[idx(c + ivec2(1, 0)) + 1]);
    float wyt = float(acc[idx(c + ivec2(0, 1)) + 3]);
    float mass = 0.25 * (wx + wxr + wy + wyt) / 4096.0;

    // Mass also goes in .z. R32F is not filterable on ES without
    // OES_texture_float_linear, and the cohesion force needs a smooth gradient,
    // so it rides in the rgba16f field where bilinear sampling is guaranteed.
    imageStore(uVel, c, vec4(v, mass, 0.0));
    imageStore(uMass, c, vec4(mass, 0.0, 0.0, 0.0));
}
