#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

// Resolves the fixed-point accumulator into the velocity field: each face is
// its accumulated momentum over its accumulated weight. Wall faces -- the
// left face of column zero, the bottom face of row zero -- are pinned to
// zero, which is the reference's "restore solid cells" for static walls.
//
// u and v live in separate r32f images: the solve updates them in place, and
// r32f is the only float format ES 3.1 guarantees read-write image access
// for. Density gets an rgba16f texture of its own because cohesion needs a
// smooth bilinear gradient and r32f is not filterable.

layout(std430, binding = 1) buffer GridAccum { int acc[]; };

layout(r32f,    binding = 0) writeonly uniform highp image2D uU;
layout(r32f,    binding = 2) writeonly uniform highp image2D uV;
layout(rgba16f, binding = 3) writeonly uniform highp image2D uDensity;

uniform ivec2 uGrid;

const float SCALE = 4096.0;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= uGrid.x || c.y >= uGrid.y) return;

    int i = (c.y * uGrid.x + c.x) * 6;
    float wx = float(acc[i + 1]);
    float wy = float(acc[i + 3]);

    float u = wx > 0.5 ? float(acc[i]) / wx : 0.0;
    float v = wy > 0.5 ? float(acc[i + 2]) / wy : 0.0;

    if (c.x == 0) u = 0.0;   // left wall face
    if (c.y == 0) v = 0.0;   // bottom wall face

    float density = float(acc[i + 4]) / SCALE;

    imageStore(uU, c, vec4(u, 0.0, 0.0, 0.0));
    imageStore(uV, c, vec4(v, 0.0, 0.0, 0.0));
    imageStore(uDensity, c, vec4(density, 0.0, 0.0, 0.0));
}
