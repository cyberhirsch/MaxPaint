#version 310 es
precision highp float;
precision highp sampler2D;
layout(local_size_x = 256) in;

// Pixel sorting -- the Glitch brush's first mode.
//
// The classic effect (Kim Asendorf's): along each row (or column), pixels
// whose brightness falls inside a band form "runs"; every run is sorted by
// brightness in place, and everything outside the band stays put. Under a
// brush it becomes a mark: each dab sorts the segments of every line that
// cross its disc.
//
// One workgroup per line, 256 threads per workgroup -- one pixel each, so a
// disc up to 255 pixels across. The line is loaded into shared memory, run
// membership is resolved with a serial scan (256 steps, trivial), and a
// bitonic sort orders by (run, brightness): runs are contiguous and their
// ids increase along the line, so sorting by run id first keeps every run
// where it was, and every out-of-band pixel is a run of its own, so it never
// moves at all.

layout(binding = 0) uniform highp sampler2D uSrc;
layout(binding = 1) uniform highp sampler2D uProps;   // r h, gb normal, a ao
layout(rgba16f, binding = 0) writeonly uniform highp image2D uDst;

uniform ivec2 uCentre;    // disc centre, texels
uniform int   uRadius;    // disc radius, texels (<= 127)
uniform int   uVertical;  // 0: sort along rows, 1: along columns
uniform float uLo;        // brightness band, over white paper
uniform float uHi;
uniform int   uDescending;
uniform float uFalloff;   // 0: hard edge; 1: fade from the centre out

// Property-driven sorting. uEdgeBound breaks runs where the picture has an
// edge instead of only where the brightness band ends, so a contour holds the
// sort back: silhouettes survive while the smooth interiors they enclose
// liquefy. uAutoDir lets the surface choose the axis -- the dab sorts along
// whichever way the layer tilts hardest under its centre, so a stroke follows
// the form rather than the screen.
// uEdgeBound is a sensitivity, 0 off .. 1 fussiest, not a raw slope: the
// stored normal is normalised, so length(n.xy) is sin(tilt) and saturates
// near 1 -- at Steepness 40 plain skin texture already reads as a wall. The
// test is on tan(tilt) instead, which stays proportional to the height step
// the picture actually takes, and the slider maps onto a useful span of it.
uniform float uEdgeBound;
uniform int   uAutoDir;     // 1: take the axis from the normal, not uVertical

shared vec4  sCol[256];
shared float sKey[256];
shared int   sIdx[256];
shared int   sMask[256];

ivec2 texelFor(int vertical, int line, int along) {
    return vertical == 0 ? ivec2(along, line) : ivec2(line, along);
}

void main() {
    int t = int(gl_LocalInvocationID.x);
    ivec2 size = textureSize(uSrc, 0);

    // Every workgroup reads the same texel for this, so they all agree on the
    // axis without needing to be told.
    int vertical = uVertical;
    if (uAutoDir == 1) {
        vec2 n = texelFetch(uProps, clamp(uCentre, ivec2(0), size - ivec2(1)), 0).gb;
        vertical = abs(n.y) > abs(n.x) ? 1 : 0;
    }

    // this workgroup's line, and the segment of it inside the disc
    int lineOffset = int(gl_WorkGroupID.x) - uRadius;
    int line = (vertical == 0 ? uCentre.y : uCentre.x) + lineOffset;
    int halfSpan = int(sqrt(max(float(uRadius * uRadius - lineOffset * lineOffset), 0.0)));
    int centreAlong = vertical == 0 ? uCentre.x : uCentre.y;
    int start = centreAlong - halfSpan;
    int len = 2 * halfSpan + 1;

    int along = start + t;
    ivec2 p = texelFor(vertical, line, along);
    int limitAlong = vertical == 0 ? size.x : size.y;
    int limitLine = vertical == 0 ? size.y : size.x;
    bool valid = t < len && line >= 0 && line < limitLine &&
                 along >= 0 && along < limitAlong;

    vec4 c = valid ? texelFetch(uSrc, p, 0) : vec4(0.0);
    // brightness as seen on the page: premultiplied paint over white paper
    float lum = dot(c.rgb + vec3(1.0 - c.a), vec3(0.299, 0.587, 0.114));

    // Edge falloff. Toward the rim the band closes on its own midpoint, so
    // fewer pixels qualify and the runs that do form are shorter: the mark
    // thins out instead of stopping at a hard circle. This changes only which
    // pixels take part, so the result stays a permutation of the ones that
    // did -- nothing is blended and no colour is invented, which is what a
    // cross-fade against the original would cost. uFalloff is the fraction of
    // the radius the fade spans, so 0 leaves the band exactly as given.
    float lo = uLo, hi = uHi;
    if (uFalloff > 0.0) {
        float dAlong = float(along - centreAlong);
        float dist = sqrt(dAlong * dAlong + float(lineOffset * lineOffset));
        float rim = clamp(dist / max(float(uRadius), 1.0), 0.0, 1.0);
        float w = clamp((1.0 - rim) / uFalloff, 0.0, 1.0);
        w = w * w * (3.0 - 2.0 * w);          // smoothstep, so the edge eases
        float mid = 0.5 * (lo + hi);
        float halfBand = 0.5 * (hi - lo) * w;
        lo = mid - halfBand; hi = mid + halfBand;
    }
    bool inBand = valid && lum >= lo && lum <= hi;

    // An edge is a wall the sort will not cross: make it out-of-band and the
    // existing run scan does the rest, since every out-of-band pixel is a run
    // of its own and never moves.
    if (uEdgeBound > 0.0 && valid) {
        vec2 n = texelFetch(uProps, p, 0).gb;
        float sinT = min(length(n), 0.9999);
        float tanT = sinT / max(sqrt(1.0 - sinT * sinT), 1e-4);
        if (tanT > mix(6.0, 0.5, clamp(uEdgeBound, 0.0, 1.0))) inBand = false;
    }

    sCol[t] = c;
    sMask[t] = inBand ? 1 : 0;
    sIdx[t] = t;
    sKey[t] = uDescending == 1 ? -lum : lum;
    barrier();

    // run ids: a band pixel continues the previous band pixel's run; every
    // out-of-band pixel is a run of its own
    if (t == 0) {
        int run = 0;
        for (int i = 0; i < 256; i++) {
            if (i > 0 && !(sMask[i] == 1 && sMask[i - 1] == 1)) run++;
            // brightness sits in [-1, 1]; runs are spaced 4 apart so it can
            // never cross into the neighbouring run
            sKey[i] = float(run) * 4.0 + (sMask[i] == 1 ? sKey[i] : 0.0);
        }
    }
    barrier();

    // bitonic sort of 256 keys, payload is the original index
    for (int k = 2; k <= 256; k <<= 1) {
        for (int j = k >> 1; j > 0; j >>= 1) {
            int partner = t ^ j;
            if (partner > t) {
                bool ascending = (t & k) == 0;
                float a = sKey[t];
                float b = sKey[partner];
                if ((a > b) == ascending) {
                    sKey[t] = b; sKey[partner] = a;
                    int ia = sIdx[t]; sIdx[t] = sIdx[partner]; sIdx[partner] = ia;
                }
            }
            barrier();
        }
    }

    if (valid) imageStore(uDst, p, sCol[sIdx[t]]);
}
