#version 310 es
precision highp float;
layout(local_size_x = 8, local_size_y = 8) in;

// ES 3.1 only allows read-write images for r32*, so rgba16f must ping-pong.
layout(rgba16f, binding = 0) readonly  uniform highp image2D uSrc;
layout(rgba16f, binding = 1) writeonly uniform highp image2D uDst;

uniform vec2  uPoint;    // UV
uniform vec4  uValue;    // amount to add at the centre
uniform float uRadius;   // in UV units
uniform float uAspect;   // width / height
uniform vec2  uAxis;     // unit vector along the contact's long axis, world space
uniform float uMinor;    // minor over major; 1.0 is a circle
// The dye can take its colour from a reference picture instead of carrying
// uValue's: sampled per texel, so a stroke lifts the photograph it crosses and
// the solver then swirls it. uValue.a still sets how much goes down. 0 leaves
// the old behaviour, which is what the phone still asks for.
layout(binding = 0) uniform highp sampler2D uRef;
uniform int   uColourFrom;
uniform int   uMode;     // 0 = add (paint), 1 = lerp toward uValue (reset age),
                         // 2 = scale down (solvent lifting pigment)

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uDst);
    if (c.x >= sz.x || c.y >= sz.y) return;

    vec4 prev = imageLoad(uSrc, c);

    vec2 uv = (vec2(c) + 0.5) / vec2(sz);
    vec2 d = uv - uPoint;
    d.x *= uAspect;

    // Into the contact patch's own frame, stretching across its short axis so
    // one radius describes an ellipse. uAxis (1,0) with uMinor 1 is a circle
    // and reproduces the round dab exactly.
    // A zero axis or minor means nobody set them -- an unset uniform is 0, and
    // a degenerate frame would inflate the dab over the whole canvas. The
    // failure-safe reading of "no contact reported" is a circle.
    vec2 ax = dot(uAxis, uAxis) > 0.5 ? uAxis : vec2(1.0, 0.0);
    float mn = uMinor > 0.05 ? uMinor : 1.0;

    vec2 e = vec2(dot(d, ax), dot(d, vec2(-ax.y, ax.x)) / mn);

    float falloff = exp(-dot(e, e) / max(uRadius * uRadius, 1e-8));

    vec4 value = uValue;
    if (uColourFrom == 1) {
        // premultiplied: take the reference's own colour at its own coverage,
        // then weigh it by how much ink this dab is laying down
        vec4 ref = texture(uRef, uv);
        value = vec4(ref.rgb, max(ref.a, 1e-4)) * uValue.a;
    }

    vec4 result;
    if (uMode == 1) {
        result = mix(prev, value, falloff);
    } else if (uMode == 2) {
        // uValue.x is how much is left where the brush bites hardest
        result = prev * mix(1.0, value.x, falloff);
    } else {
        result = prev + value * falloff;
    }
    imageStore(uDst, c, result);
}
