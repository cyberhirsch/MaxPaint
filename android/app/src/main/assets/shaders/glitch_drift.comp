#version 310 es
precision highp float;
precision highp sampler2D;
layout(local_size_x = 8, local_size_y = 8) in;

// Channel drift -- the Glitch brush's second mode.
//
// Red and blue are pulled apart along the stroke axis while green holds its
// place, so edges grow the colour fringes of a misregistered scan. On a grey
// photograph there is no colour to begin with: the fringes are made by the
// separation itself, which is why it reads even on black and white.
//
// The offset shrinks to nothing at the rim, so the dab ends by agreeing with
// the layer rather than by stopping. Alpha comes from the undrifted centre
// sample: the layer is premultiplied, and dragging coverage around with the
// colour would punch holes in the paint rather than colour its edges.

layout(binding = 0) uniform highp sampler2D uSrc;
layout(rgba16f, binding = 0) writeonly uniform highp image2D uDst;

uniform ivec2 uCentre;
uniform int   uRadius;
uniform float uFalloff;   // 0 hard edge, 1 fade from the centre
uniform int   uVertical;  // 0 drift along x, 1 along y
uniform float uAmount;    // separation in texels at full strength

float edgeWeight(vec2 d) {
    if (uFalloff <= 0.0) return 1.0;
    float rim = clamp(length(d) / max(float(uRadius), 1.0), 0.0, 1.0);
    float w = clamp((1.0 - rim) / uFalloff, 0.0, 1.0);
    return w * w * (3.0 - 2.0 * w);
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    int span = 2 * uRadius + 1;
    if (g.x >= span || g.y >= span) return;

    ivec2 d = g - ivec2(uRadius);
    if (d.x * d.x + d.y * d.y > uRadius * uRadius) return;

    ivec2 p = uCentre + d;
    ivec2 lim = textureSize(uSrc, 0);
    if (p.x < 0 || p.y < 0 || p.x >= lim.x || p.y >= lim.y) return;

    vec2 axis = uVertical == 1 ? vec2(0.0, 1.0) : vec2(1.0, 0.0);
    ivec2 off = ivec2(round(axis * uAmount * edgeWeight(vec2(d))));

    vec4 mid = texelFetch(uSrc, p, 0);
    vec4 a = texelFetch(uSrc, clamp(p + off, ivec2(0), lim - ivec2(1)), 0);
    vec4 b = texelFetch(uSrc, clamp(p - off, ivec2(0), lim - ivec2(1)), 0);
    imageStore(uDst, p, vec4(a.r, mid.g, b.b, mid.a));
}
