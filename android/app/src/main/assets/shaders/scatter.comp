#version 310 es
precision highp float;
precision highp sampler2D;
layout(local_size_x = 8, local_size_y = 8) in;

// Scatter: boxes strewn through the brush disc, each one turned and stretched
// by the picture it lands on.
//
// The property map stores the height field's surface normal, and its xy is the
// gradient -- the direction the picture changes fastest, which runs ACROSS an
// edge. A feature therefore runs along the perpendicular, and that is the axis
// a box takes: on a cheekbone the boxes lie along the bone, in flat sky they
// have no direction to find and stay square. The gradient's length says how
// strong the feature is, so it also sets how far the box stretches along it
// and how far it squeezes across -- edges give long thin slivers, flats give
// squares, and the same slider does both because they are the same fact.
//
// The brush deposits no pigment of its own. Every box takes a colour already
// in the layer -- from under itself, from somewhere else in the disc, or from
// anywhere in the picture -- so a blank canvas stays blank and a photograph
// comes apart into its own palette.

// uSrc is the layer being painted, and is only read so an uncovered texel can
// keep what was there. uRef is the picture the brush LOOKS at: where the
// colour comes from, and what the property map was derived from. They are the
// same texture until a reference layer is chosen, and separating them is what
// lets you scatter a photograph onto an empty layer above it.
layout(binding = 0) uniform highp sampler2D uSrc;
layout(binding = 1) uniform highp sampler2D uStruct;  // rg orientation, b edge
layout(binding = 2) uniform highp sampler2D uRef;
layout(rgba16f, binding = 0) writeonly uniform highp image2D uDst;

uniform ivec2 uCentre;
uniform int   uRadius;      // where box CENTRES are scattered
// How far this pass may write. The disc decides where boxes start, not where
// they are allowed to end: a box whose centre sits near the rim still gets
// laid down whole, so the brush outline never saws one in half. uReach is the
// radius plus the largest a box can grow, and the host works it out.
uniform int   uReach;
uniform float uFalloff;
uniform ivec2 uSize;        // the canvas
uniform int   uCount;       // boxes in this dab
uniform float uBoxSize;     // half-extent before the picture gets a say, texels
uniform float uStretch;     // how hard an edge draws the box out along itself
// Shapes what counts as an edge. Above 1 the stretch is saved for real
// contours and everything softer stays square; below 1 it is spread over the
// faintest texture. The raw measure needs this: a picture is mostly gentle
// slope, and without a bias the brush stretches everything equally.
uniform float uBias;
uniform float uAlign;       // 0 keeps them square to the screen, 1 to the feature
uniform float uOpacity;
uniform int   uColourFrom;  // 0 under the box, 1 elsewhere in the disc, 2 anywhere
uniform float uJitter;      // size spread between boxes
uniform float uSeed;

float hash(float n) { return fract(sin(n) * 43758.5453); }

// The rim thins the scatter instead of fading it: a box is either laid down
// whole or not at all, so every box keeps its edges.
float edgeWeight(vec2 d) {
    if (uFalloff <= 0.0) return 1.0;
    float rim = clamp(length(d) / max(float(uRadius), 1.0), 0.0, 1.0);
    float w = clamp((1.0 - rim) / uFalloff, 0.0, 1.0);
    return w * w * (3.0 - 2.0 * w);
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    int span = 2 * uReach + 1;
    if (g.x >= span || g.y >= span) return;

    ivec2 d = g - ivec2(uReach);
    ivec2 p = uCentre + d;
    if (p.x < 0 || p.y < 0 || p.x >= uSize.x || p.y >= uSize.y) return;

    // start from what is already there; a texel no box covers keeps the layer
    vec4 outc = texelFetch(uSrc, p, 0);

    for (int i = 0; i < uCount; i++) {
        float s = uSeed + float(i) * 17.31;

        // centre, scattered evenly over the disc
        float a = hash(s) * 6.2831853;
        float rr = sqrt(hash(s + 1.3)) * float(uRadius);
        vec2 off = vec2(cos(a), sin(a)) * rr;
        if (hash(s + 2.7) > edgeWeight(off)) continue;

        ivec2 bc = clamp(uCentre + ivec2(round(off)), ivec2(0), uSize - ivec2(1));

        // The direction field, already smoothed so a nearby contour can speak
        // for flat ground: rg carries the orientation at double angle scaled
        // by how much the neighbourhood agrees, b how much of an edge this
        // place counts as once its neighbours have had their say.
        vec4 st = texelFetch(uStruct, bc, 0);
        float edge = pow(clamp(st.b, 0.0, 1.0), max(uBias, 0.01));

        // half the doubled angle to get back to an orientation
        float ang = dot(st.rg, st.rg) > 1e-8 ? 0.5 * atan(st.g, st.r) : 0.0;
        // A box is the same box turned half a turn, so fold into one before
        // easing toward it -- otherwise two identical edges reported as +179
        // and -179 degrees swing opposite ways at part alignment.
        if (ang > 1.5707963) ang -= 3.14159265;
        if (ang < -1.5707963) ang += 3.14159265;
        ang *= clamp(uAlign, 0.0, 1.0);
        vec2 axis = vec2(cos(ang), sin(ang));

        float jit = 1.0 + (hash(s + 4.1) * 2.0 - 1.0) * uJitter;
        float grow = 1.0 + uStretch * edge;
        float halfAlong = max(uBoxSize * jit * grow, 0.5);
        float halfAcross = max(uBoxSize * jit / grow, 0.5);

        vec2 rel = vec2(p - bc);
        float u = dot(rel, axis);
        float v = dot(rel, vec2(-axis.y, axis.x));
        if (abs(u) > halfAlong || abs(v) > halfAcross) continue;

        ivec2 cpos;
        if (uColourFrom == 0) {
            cpos = bc;
        } else if (uColourFrom == 1) {
            float a2 = hash(s + 5.5) * 6.2831853;
            float r2 = sqrt(hash(s + 6.1)) * float(uRadius);
            cpos = uCentre + ivec2(round(vec2(cos(a2), sin(a2)) * r2));
        } else {
            cpos = ivec2(hash(s + 7.3) * float(uSize.x),
                         hash(s + 8.9) * float(uSize.y));
        }
        vec4 c = texelFetch(uRef, clamp(cpos, ivec2(0), uSize - ivec2(1)), 0) * uOpacity;

        // premultiplied, so a box over a box is a plain "over"
        outc = c + outc * (1.0 - clamp(c.a, 0.0, 1.0));
    }

    imageStore(uDst, p, outc);
}
